#!/data/data/com.termux/files/usr/bin/bash
# Serviço runit: 1 backup por dia após as 03:00; se perder o horário (aparelho desligado), recupera ao voltar.
# Em caso de falha, só tenta de novo depois de 2h, para não gerar pacotes locais em excesso.
set -u
DATA="$HOME/.local/share/ritmo"
ROOT="$HOME/ritmo-termux"
mkdir -p "$DATA"
while true; do
    today="$(date +%F)"
    hour=$((10#$(date +%H)))
    last_ok="$(cat "$DATA/backup-last-success" 2>/dev/null || true)"
    last_try="$(cat "$DATA/backup-last-attempt" 2>/dev/null || echo 0)"
    now="$(date +%s)"
    if [ "$hour" -ge 3 ] && [ "$last_ok" != "$today" ] && [ $((now - last_try)) -ge 7200 ]; then
        echo "$now" > "$DATA/backup-last-attempt"
        "$ROOT/scripts/termux-backup.sh" daily || echo "Backup falhou (código $?); nova tentativa em cerca de 2h."
    fi
    sleep 900
done
