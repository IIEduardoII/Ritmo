# Execute python3 scripts/setup.py para gerar .env com segredos aleatórios.
MYSQL_DATABASE=treinos
MYSQL_USER=treinos
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
SECRET_KEY=
HTTP_PORT=8088
COOKIE_SECURE=true

# Antes de ativar, leia README.md: somente projeto SEM faturamento ativo.
# As chaves herdam o plano e as cotas do projeto. Não use chave de projeto pago.
GEMINI_ENABLED=false
GEMINI_FREE_PROJECT_CONFIRMED=false
GEMINI_API_KEY=
